# このファイルをコピーして .env を作り、値を入れてください（.env がもうあるときはコピーしない。上書きされて値が消える）。
#   if (Test-Path .env) { "もう .env があるので、コピーしませんでした" } else { Copy-Item .env.example .env; ".env を作りました" }
# .env はパスワードやキーが入るので、Git やチャットに載せないこと（.gitignore で除外済み）。

# 管理者用サイトのログインパスワード（チームで共有する1つ）
ADMIN_PASSWORD=

# 中継スクリプト（PC・タブレット）が /api/sync に送るときのキー。長いランダムな文字列にする。
# 作り方: .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_hex(32))"
SYNC_API_KEY=

# ログイン状態の署名に使う文字列（作り方は上と同じ）。空なら起動のたびに作り直す（再起動するとログアウトになる）。
SESSION_SECRET=

# DB ファイルの場所（プロジェクトのフォルダから見た場所）
DB_PATH=data/omamori.db

# ---- LINE（本人用）。使うときだけ。README の「LINE（本人用）」を参照 ----
# LINE Developers の Messaging API チャネルの「チャネルシークレット」（LINE から届いたものか確かめるのに使う）
LINE_CHANNEL_SECRET=
# 同じチャネルの「チャネルアクセストークン（長期）」（返事を送るのに使う）
LINE_CHANNEL_ACCESS_TOKEN=
# 1 にすると「試し運転」: LINE には返事を送らず、scripts/fake_line.py で返事を見るだけにする
LINE_DRY_RUN=
